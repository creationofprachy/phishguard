# PhishGuard does not require any secrets or API keys to run locally.
# This file is provided for future extensions (e.g. if you add rate-limiting,
# a persistent database for history, or an external threat-intel API).

# Example: host/port overrides if you wrap uvicorn in your own launcher
# HOST=127.0.0.1
# PORT=8000

# Example: if you later add a threat-intel enrichment API
# THREAT_INTEL_API_KEY=
